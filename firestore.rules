rules_version = '2';

// =============================================
// STUDYO — Firestore Security Rules
// =============================================
// Come applicarle:
// Firebase Console -> Firestore Database -> Regole -> incolla questo -> Pubblica
//
// Sostituiscono la "test mode" (che scade dopo 30 giorni e lascia il DB aperto a tutti).
// =============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Validazione base del documento utente: impedisce campi giganti o tipi errati.
    function isValidUser() {
      return request.resource.data.xp is number
             && request.resource.data.xp >= 0
             && request.resource.data.name is string
             && request.resource.data.name.size() < 100;
    }

    // Amministratore = campo isAdmin nel proprio documento users,
    // che si imposta SOLO a mano dalla Console Firebase (vedi regole users).
    function isAdmin() {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ---- UTENTI ----
    // Lettura consentita a qualsiasi utente autenticato (community/leaderboard).
    // Scrittura solo sul proprio documento.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && isValidUser()
                    && !('isAdmin' in request.resource.data);

      // Nessuno può promuoversi da solo: isAdmin si cambia solo dalla Console
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && isValidUser()
                    && (
                         (!('isAdmin' in request.resource.data) && !('isAdmin' in resource.data))
                         || ('isAdmin' in resource.data && request.resource.data.isAdmin == resource.data.isAdmin)
                       );

      allow delete: if false;
    }

    // ---- FEEDBACK ----
    // Chiunque sia autenticato puo creare un feedback.
    // Lettura/modifica/cancellazione bloccate dal client (li leggi dalla Console).
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 5000;
      allow read, update, delete: if false;
    }

    // ---- PRESENZA REAL-TIME ----
    // Tutti gli autenticati leggono chi e online; ognuno scrive solo il proprio doc.
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- CHAT DELLE LOBBY ----
    // Messaggi leggibili da tutti gli autenticati; creazione col proprio uid.
    match /lobbies/{lobbyId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 1000;
      allow update, delete: if false;
    }

    // ---- GRUPPI DI STUDIO PRIVATI ----
    // Lettura per autenticati (serve per entrare col codice).
    // Creazione: devi essere tu il proprietario e il primo membro.
    // Aggiornamento: consentito agli autenticati (entrare/uscire dal gruppo),
    // ma proprietario e codice non possono essere cambiati.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 60;
      allow update: if request.auth != null
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.code == resource.data.code;
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ---- SESSIONI PROGRAMMATE ----
    // Chiunque autenticato le vede e può partecipare;
    // solo chi l'ha creata può cancellarla.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.startAt is number;
      allow update: if request.auth != null
                    && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if request.auth != null
                    && resource.data.creatorId == request.auth.uid;
    }

    // ---- APPUNTI ----
    // Ognuno scrive solo i propri (id documento = uid_materia).
    // In lettura passano solo i propri o quelli marcati come condivisi.
    match /notes/{noteId} {
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || resource.data.shared == true);
      allow create, update: if request.auth != null
                  && request.resource.data.uid == request.auth.uid
                  && request.resource.data.text is string
                  && request.resource.data.text.size() < 20000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---- COM'È L'ESAME (recensioni sull'esame) ----
    // Id documento = uid_materia: una sola recensione per persona per esame.
    // Scrivono solo gli universitari; nessun campo parla del docente.
    function isUniStudent() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !('school' in u) || u.school == 'universita';
    }

    function isValidReview(reviewId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'lobbyId', 'authorName', 'uni', 'uniKey',
                               'difficulty', 'hours', 'year', 'examTypes', 'parziali',
                               'material', 'tip', 'reportedBy', 'createdAt', 'updatedAt'])
             && d.uid == request.auth.uid
             && d.lobbyId is string && d.lobbyId.size() > 0 && d.lobbyId.size() < 80
             && reviewId == request.auth.uid + '_' + d.lobbyId
             && d.authorName is string && d.authorName.size() < 100
             && d.uni is string && d.uni.size() <= 120
             && d.uniKey is string && d.uniKey.size() <= 120
             && d.difficulty is int && d.difficulty >= 1 && d.difficulty <= 5
             && d.hours is int && d.hours >= 1 && d.hours <= 1000
             && d.year is int && d.year >= 2000 && d.year <= 2100
             && d.examTypes is list && d.examTypes.size() >= 1 && d.examTypes.size() <= 5
             && d.parziali in ['si', 'no', 'nonso']
             && d.material is string && d.material.size() <= 800
             && d.tip is string && d.tip.size() <= 800
             && d.updatedAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && isValidReview(reviewId)
                    && request.resource.data.reportedBy == []
                    && request.resource.data.createdAt == request.time
                    && isUniStudent();

      // L'autore modifica la sua, ma non può azzerare le segnalazioni
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && isValidReview(reviewId)
                    && request.resource.data.reportedBy == resource.data.reportedBy
                    && request.resource.data.createdAt == resource.data.createdAt;

      // Gli altri possono solo aggiungere il proprio uid alle segnalazioni
      allow update: if request.auth != null
                    && resource.data.uid != request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
                    && !(request.auth.uid in resource.data.reportedBy)
                    && request.resource.data.reportedBy.size() == resource.data.reportedBy.size() + 1
                    && request.resource.data.reportedBy.hasAll(resource.data.reportedBy)
                    && request.auth.uid in request.resource.data.reportedBy;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---- CONTENUTI DI STUDIO (quiz e flashcard per materia) ----
    // Li legge chiunque abbia un account, li scrivono solo gli amministratori.
    function isValidContent() {
      let d = request.resource.data;
      return d.keys().hasOnly(['quiz', 'cards', 'updatedBy', 'updatedAt'])
             && d.quiz is list && d.quiz.size() <= 50
             && d.cards is list && d.cards.size() <= 80
             && d.updatedBy == request.auth.uid;
    }

    match /content/{lobbyId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isValidContent();
    }

    // ---- SEGNALAZIONI ----
    // Si creano soltanto; le leggi dalla Console per moderare.
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.type is string
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() < 200
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }

    // ---- DEFAULT DENY ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
