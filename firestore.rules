rules_version = '2';

// =============================================
// STUDYO — Firestore Security Rules
// =============================================
// Come applicarle:
// Firebase Console -> Firestore Database -> Regole -> incolla questo -> Pubblica
//
// Sostituiscono la "test mode" (che scade dopo 30 giorni e lascia il DB aperto a tutti).
// =============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Validazione base del documento utente: impedisce campi giganti o tipi errati.
    function isValidUser() {
      return request.resource.data.xp is number
             && request.resource.data.xp >= 0
             && request.resource.data.name is string
             && request.resource.data.name.size() < 100;
    }

    // ---- UTENTI ----
    // Lettura consentita a qualsiasi utente autenticato (community/leaderboard).
    // Scrittura solo sul proprio documento.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && isValidUser();

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && isValidUser();

      allow delete: if false;
    }

    // ---- FEEDBACK ----
    // Chiunque sia autenticato puo creare un feedback.
    // Lettura/modifica/cancellazione bloccate dal client (li leggi dalla Console).
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 5000;
      allow read, update, delete: if false;
    }

    // ---- PRESENZA REAL-TIME ----
    // Tutti gli autenticati leggono chi e online; ognuno scrive solo il proprio doc.
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- CHAT DELLE LOBBY ----
    // Messaggi leggibili da tutti gli autenticati; creazione col proprio uid.
    match /lobbies/{lobbyId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 1000;
      allow update, delete: if false;
    }

    // ---- GRUPPI DI STUDIO PRIVATI ----
    // Lettura per autenticati (serve per entrare col codice).
    // Creazione: devi essere tu il proprietario e il primo membro.
    // Aggiornamento: consentito agli autenticati (entrare/uscire dal gruppo),
    // ma proprietario e codice non possono essere cambiati.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 60;
      allow update: if request.auth != null
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.code == resource.data.code;
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ---- SESSIONI PROGRAMMATE ----
    // Chiunque autenticato le vede e può partecipare;
    // solo chi l'ha creata può cancellarla.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.startAt is number;
      allow update: if request.auth != null
                    && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if request.auth != null
                    && resource.data.creatorId == request.auth.uid;
    }

    // ---- APPUNTI ----
    // Ognuno scrive solo i propri (id documento = uid_materia).
    // In lettura passano solo i propri o quelli marcati come condivisi.
    match /notes/{noteId} {
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || resource.data.shared == true);
      allow create, update: if request.auth != null
                  && request.resource.data.uid == request.auth.uid
                  && request.resource.data.text is string
                  && request.resource.data.text.size() < 20000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---- DEFAULT DENY ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
